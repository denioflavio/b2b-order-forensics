            ```
    }
    region breadcrumb (
        name: Home
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )
    region shop-content (
        name: Welcome
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                  l_html clob;

                  function esc(p_text varchar2) return varchar2 is
                  begin return apex_escape.html(p_text); end;
                  function url(p_page number,p_order number default null) return varchar2 is
                  begin
                    return apex_escape.html_attribute(apex_page.get_url(p_page=>p_page, p_clear_cache=>case when p_page=50 then '50' end, p_items=>case when p_order is not null then 'P50_ORDER_ID' end,p_values=>to_char(p_order)));
                  end;
                  function money(p_value number) return varchar2 is
                  begin return 'R$ '||to_char(p_value,'FM999G999G990D00','NLS_NUMERIC_CHARACTERS=''.,'''); end;
                  function status_label(p_status varchar2) return varchar2 is
                  begin return case p_status when 'COMPLETED' then 'Confirmed' when 'ERROR' then 'Needs attention'
                    when 'PROCESSING' then 'Processing' else 'Awaiting confirmation' end; end;

                begin
                  l_html := '<div class="bf-shop"><section class="bf-hero"><div><p class="bf-eyebrow">ACME WORKSPACE / COMPANY STORE</p><h1>Good tools.<br>Better workdays.</h1><p class="bf-lead">Thoughtful tech for the way your team works. Explore everyday essentials, from your first screen to the finishing touches.</p><div class="bf-actions"><a class="bf-btn bf-btn-primary" href="'||url(20)||'">Explore products <span aria-hidden="true">&rarr;</span></a><a class="bf-btn" href="'||url(10)||'">My orders</a></div></div><div class="bf-art bf-art-laptop" role="img" aria-label="Illustration of a notebook computer"></div></section><section class="bf-benefits" aria-label="Shop by purpose"><article><p class="bf-eyebrow">01 / YOUR DESK</p><h2>A fresh perspective</h2><p>Computers and displays for your next big idea.</p></article><article><p class="bf-eyebrow">02 / YOUR ROUTINE</p><h2>The everyday details</h2><p>Comfortable peripherals that fit right in.</p></article><article><p class="bf-eyebrow">03 / YOUR TEAM</p><h2>Stay connected</h2><p>Audio, video and the connections in between.</p></article></section></div>';
                  return l_html;
                end;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: shop-region
        }
    )
)
